# Copy to .env.local (Docker on this computer) or .env.prod (the real server),
# then fill in. Those two files are gitignored; this one is committed.

# The one password everyone who makes the bulletin shares. Required whenever
# the app is reachable beyond this computer, which includes inside Docker.
BULLETIN_PASSWORD=

# Railway only: its volumes belong to root, and the app runs as a regular user.
# RAILWAY_RUN_UID=0

# Set by Railway itself; the default is 8000.
# PORT=8000
